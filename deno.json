{
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false
  },
  "lint": {
    "rules": {
      "exclude": [
        "ban-unused-ignore",
        "no-empty",
        "no-explicit-any",
        "no-import-prefix",
        "no-unversioned-import",
        "no-unused-vars",
        "prefer-const",
        "require-await"
      ]
    }
  },
  "tasks": {
    "check:functions": "deno check supabase/functions/*/index.ts",
    "lint:functions": "deno lint supabase/functions",
    "test:functions": "deno test supabase/functions"
  }
}
