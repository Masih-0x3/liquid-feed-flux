VITE_SUPABASE_PUBLISHABLE_KEY="<set-in-vercel-or-local-env>"
VITE_SUPABASE_URL="https://jzirqfzzvlbxwfzndaer.supabase.co"

# Frontend Sentry project: xot-web
VITE_SENTRY_DSN="<xot-web-sentry-dsn>"
VITE_SENTRY_ENVIRONMENT="production"
VITE_SENTRY_TRACES_SAMPLE_RATE="0.1"
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE="0"
