# Safe local/Preview template. Use only isolated staging public values.
# Do not copy production values into this file. Preview must never target the
# production Supabase project. Local is a disposable validation lane, not a
# persistent full-stack environment.
XOT_ENVIRONMENT="preview"
VITE_SUPABASE_PROJECT_ID="<staging-project-ref>"
VITE_SUPABASE_PUBLISHABLE_KEY="<staging-publishable-key>"
VITE_SUPABASE_URL="https://<staging-project-ref>.supabase.co"
# Server/runtime identity values for the isolated staging deployment.
RENDERER_ID="xot-staging-1"
VIDEO_RENDERER_URL="<staging-renderer-url>"
ALLOW_EXTERNAL_POSTING="false"

# Frontend Sentry project: xot-web
VITE_SENTRY_DSN="<xot-web-sentry-dsn>"
VITE_SENTRY_ENVIRONMENT="preview"
VITE_SENTRY_TRACES_SAMPLE_RATE="0.1"
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE="0"
VITE_SENTRY_REPLAYS_ERROR_SAMPLE_RATE="1"

# Build-only source-map upload. Set in CI/Vercel, never commit a real token.
SENTRY_AUTH_TOKEN="<sentry-source-map-upload-token>"
SENTRY_ORG="xot"
SENTRY_PROJECT="xot-web"

# Supabase Edge Functions Sentry project: xot-edge
SENTRY_DSN="<xot-edge-sentry-dsn>"
SENTRY_ENVIRONMENT="preview"
SENTRY_TRACES_SAMPLE_RATE="0.1"
SENTRY_RELEASE=
