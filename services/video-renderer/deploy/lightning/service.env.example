# XOT Lightning service control env — NON-SECRET TEMPLATE.
#
# Copy to: /teamspace/studios/this_studio/xot-renderer/runtime/service.env
# Set mode: chmod 600
# This file selects the source/image/control bundle. It must never contain
# SUPABASE, OpenAI, Deepgram, renderer tokens, or any other secret value.
# The user unit loads this file on Studio wake.

# candidate keeps restart policy "no" until full acceptance.
# Change both non-secret control values to persistent/unless-stopped only after
# acceptance and the persistence drill.
XOT_RENDERER_SERVICE_PROFILE=candidate
XOT_RENDERER_RESTART_POLICY=no

# These four values isolate one renderer stack from another. Keep these
# production defaults for the existing renderer. Preview uses a separate
# project, port, network, and volume as shown in README.md.
XOT_RENDERER_COMPOSE_PROJECT=xot-renderer
XOT_RENDERER_HOST_PORT=8797
XOT_RENDERER_NETWORK_NAME=xot-renderer-net
XOT_RENDERER_VOLUME_NAME=xot-renderer-tmp

# Use an immutable, explicit tag for the selected source tree.
XOT_RENDERER_IMAGE_TAG=xot-video-renderer:production-legacy-REPLACE_WITH_COMMIT
XOT_RENDERER_BUILD_SOURCE=/teamspace/studios/this_studio/xot-renderer/releases/production-legacy
XOT_RENDERER_ENV_FILE=/teamspace/studios/this_studio/xot-renderer/runtime/renderer.env
XOT_RENDERER_CONTROL_DIR=/teamspace/studios/this_studio/xot-renderer/control/deploy/lightning
