# XOT Lightning renderer runtime env — TEMPLATE (no secret values).
#
# Copy to: /teamspace/studios/this_studio/xot-renderer/runtime/renderer.env
# Set mode: chmod 600
# Provision secrets from XOT-owned sources only. Never from Hermes.
# Never commit filled-in values to Git or print them in logs/chat/receipts.
#
# This file mirrors services/video-renderer/.env.example with Lightning-specific
# defaults. Secret fields are left blank; the operator fills them at provision time.

# --- Required secrets (provision from XOT-owned sources, mode 0600) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
# Required for POST /v1/render and POST /v1/preflight HTTP dispatch.
# Leave blank for poller-only operation.
VIDEO_RENDERER_TOKEN=

# --- Sentry (xot-renderer project) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_RELEASE=

# --- Runtime (Lightning defaults) ---
PORT=8787
RENDER_CONCURRENCY=1
RENDER_SHUTDOWN_GRACE_MS=30000
# Poll interval: 5000 for current candidate; 30000 for legacy bridge canary.
POLL_INTERVAL_MS=5000
HEARTBEAT_INTERVAL_MS=30000
WORK_DIR=/tmp/xot-video-renderer

# --- Fail-closed polling breaker (current candidate only) ---
# Default disabled. Only explicit accepted values (1/true) enable polling.
# Malformed values fail closed. The legacy bridge ignores this and uses DB mode.
RENDER_POLLING_ENABLED=0
# Immutable UTC cutoff for automatic poll claims. Must be ISO 8601 with Z or an
# explicit offset (e.g. 2026-08-24T18:42:28Z or 2026-08-24T18:42:28+00:00).
# Missing/blank/malformed/date-only/local-time/timezone-free values disable
# effective polling and produce zero automatic claim RPCs.
RENDER_QUEUE_CUTOFF_AT=

# --- Renderer identity (production: lightning-xot-1) ---
RENDERER_ID=lightning-xot-1

# --- Transcription / translation / vision ---
TRANSCRIPTION_PROVIDER=deepgram
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE_FALLBACKS=multi,en,fa,he,ar
ENHANCED_AUDIO_RETRY=1
SUBTITLE_TRANSCRIBE_MODEL=gpt-4o-transcribe-diarize
SUBTITLE_TRANSLATE_MODEL=gpt-5.4-mini
WATERMARK_VISION_MODEL=gpt-5.4-mini
VISION_SPECIALIST_MODE=always
TESSERACT_LANG=eng+fas+ara+heb

# --- ffmpeg / output ---
OUTPUT_PRESET=fast
OUTPUT_CRF=20
FFMPEG_THREADS=3
MAX_OUTPUT_BYTES=49000000
OUTPUT_SIZE_RETRY_CRF_STEP=4
MAX_OUTPUT_RETRY_CRF=30

# --- Delogo / OpenCV ---
DELOGO_ENGINE=opencv
MAX_DELOGO_REGIONS=2
MAX_SINGLE_DELOGO_AREA_RATIO=0.10
MAX_TOTAL_DELOGO_AREA_RATIO=0.15
OPENCV_INPAINT_ALGORITHM=telea
OPENCV_INPAINT_RADIUS=2
OPENCV_INPAINT_KERNEL=7
OPENCV_INPAINT_DILATE_ITERATIONS=2
OPENCV_INPAINT_CLOSE_ITERATIONS=1
OPENCV_INPAINT_FEATHER=0
